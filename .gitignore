# ==================================================
# EventHub — Git Ignore Configuration
# ==================================================

# --------------------------------------------------
# Dependencies & Package Managers
# --------------------------------------------------
node_modules/
frontend/node_modules/
.pnp/
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases

# --------------------------------------------------
# Python Virtual Environments & Packages
# --------------------------------------------------
.venv/
backend/.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# --------------------------------------------------
# Build Artifacts, Bundlers & Compilers
# --------------------------------------------------
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
dist/
*.tsbuildinfo
next-env.d.ts.bak

# --------------------------------------------------
# Caches & Test Coverage
# --------------------------------------------------
.turbo/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
frontend/coverage/
__pycache__/
backend/**/__pycache__/
*.py[cod]
*$py.class

# --------------------------------------------------
# Environment Variables & Secrets (NEVER COMMIT REAL SECRETS)
# --------------------------------------------------
.env
.env*.local
*.env
frontend/.env*.local
frontend/.env
backend/.env
backend/.env*.local

# Allow example environment files
!.env.example
!frontend/.env.example
!backend/.env.example

# --------------------------------------------------
# AI Agent Tooling & Local Configs (Kept Local Only)
# --------------------------------------------------
.agents/
skills-lock.json
AGENTS.md
CLAUDE.md
GEMINI.md
frontend/AGENTS.md
frontend/CLAUDE.md
frontend/GEMINI.md
*.agent.md
.agent-cache/

# --------------------------------------------------
# OS & Editor Specific Files
# --------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
